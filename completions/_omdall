#compdef omdall
# zsh completion for omdall.
#
# scripts/install.sh links this file into
# $XDG_DATA_HOME/zsh/site-functions/_omdall. zsh has no per-user
# completion directory it scans on its own, so put this in ~/.zshrc before
# compinit:
#
#   fpath=(~/.local/share/zsh/site-functions $fpath)
#
# Keep the commands and options in step with src/omdall/cli.py;
# tests/unit/test_completions.py fails when they drift apart.

# The subcommand on the line, if one has been typed yet.
_omdall_cmd() {
  local i
  for ((i = 2; i < CURRENT; i++)); do
    case $words[i] in
    add | adopt | check | approve | update | status | reviews | doctor)
      print -r -- $words[i]
      return 0
      ;;
    esac
  done
  return 1
}

# The plugin named on the line: -p NAME, --plugin NAME or --plugin=NAME, or the
# positional name or id after `approve`, `reviews` or `adopt`.
_omdall_plugin() {
  local i word cmd
  for ((i = 2; i < CURRENT; i++)); do
    case $words[i] in
    -p | --plugin)
      ((i + 1 < CURRENT)) && print -r -- $words[i+1]
      return 0
      ;;
    --plugin=*)
      print -r -- ${words[i]#--plugin=}
      return 0
      ;;
    esac
  done
  cmd=$(_omdall_cmd) || return 0
  [[ $cmd == approve || $cmd == reviews || $cmd == adopt ]] || return 0
  for ((i = 2; i < CURRENT; i++)); do
    [[ $words[i] == $cmd ]] || continue
    for ((i = i + 1; i < CURRENT; i++)); do
      word=$words[i]
      case $word in
      -p | --plugin | --sha | --reason | --url | --dir | --root | --state | --agent | \
        --model | --notify | --timeout | --max-patch) i=$((i + 1)) ;;
      -*) ;;
      *)
        print -r -- $word
        return 0
        ;;
      esac
    done
  done
  return 0
}

# The --root and --state given on the line, so _complete looks where the command
# will. A leading ~ is expanded as the shell will expand it.
_omdall_settings() {
  local i word value
  settings=()
  for ((i = 2; i < CURRENT; i++)); do
    word=$words[i]
    case $word in
    --root | --state)
      ((i + 1 < CURRENT)) || continue
      i=$((i + 1))
      value=$words[i]
      ;;
    --root=* | --state=*)
      value=${word#*=}
      word=${word%%=*}
      ;;
    *) continue ;;
    esac
    value=${(Q)value}
    [[ $value == '~' ]] && value=$HOME
    [[ $value == '~/'* ]] && value=$HOME/${value#'~/'}
    [[ -n $value ]] && settings+=($word $value)
  done
}

# Ask _complete, with the settings from the line. _call_program evaluates its
# arguments, so everything after the command is quoted.
_omdall_ask() { # <tag> <_complete arguments...>
  local tag=$1
  shift
  _call_program $tag "$words[1]" ${(q)settings} _complete ${(q)argv}
}

_omdall_complete() {
  local cur prev cmd name inline=0
  local -a flags names shas settings
  cur=$words[CURRENT]
  prev=$words[CURRENT-1]
  # --opt=value: complete the value after the =.
  if [[ $cur == --*=* ]]; then
    prev=${cur%%=*}
    cur=${cur#*=}
    compset -P 1 '*='
    inline=1
  fi
  cmd=$(_omdall_cmd) || cmd=
  name=$(_omdall_plugin)
  _omdall_settings

  case $prev in
  -p | --plugin)
    names=(${(f)"$(_omdall_ask plugins plugins 2>/dev/null)"})
    [[ -n $names[1] ]] && compadd -a names
    return
    ;;
  --sha)
    if [[ -n $name ]]; then
      shas=(${(f)"$(_omdall_ask held held "$name" 2>/dev/null)"})
      [[ -n $shas[1] ]] && compadd -a shas
    fi
    return
    ;;
  --notify)
    compadd all ready none
    return
    ;;
  --root | --state)
    _files -/
    return
    ;;
  --agent | --model | --timeout | --max-patch | --reason | --dir | --url)
    return
    ;;
  esac
  ((inline)) && return

  flags=(-h --help --root --state --agent --model --notify --timeout --max-patch)
  case $cmd in
  add) flags+=(--dir --no-enable --no-wait --json) ;;
  adopt) flags+=(--url --dir --no-wait --json) ;;
  approve) flags+=(-p --plugin --sha --reason --show -n --dry-run --no-wait) ;;
  check | update) flags+=(-p --plugin --no-wait --json) ;;
  status | reviews) flags+=(-p --plugin --json) ;;
  doctor) flags+=(-p --plugin --fix --no-wait --json) ;;
  esac
  [[ -n $cmd ]] || flags+=(--version)

  if [[ $cur == -* ]]; then
    compadd -- ${(M)flags:#${(b)cur}*}
    return
  fi

  if [[ -z $cmd ]]; then
    compadd -- add adopt check approve update status reviews doctor
  elif [[ ($cmd == approve || $cmd == reviews) && -z $name ]]; then
    names=(${(f)"$(_omdall_ask plugins plugins 2>/dev/null)"})
    [[ -n $names[1] ]] && compadd -a names
  elif [[ $cmd == adopt && -z $name ]]; then
    names=(${(f)"$(_omdall_ask unguarded unguarded 2>/dev/null)"})
    [[ -n $names[1] ]] && compadd -a names
  fi
}

_omdall_complete "$@"
